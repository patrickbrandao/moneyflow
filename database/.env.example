# Credenciais do ambiente local de desenvolvimento (Docker). Não use em produção.
POSTGRES_USER=moneyflow
POSTGRES_PASSWORD=moneyflow
POSTGRES_DB=moneyflow
# Senha do papel moneyflow_app (usado pela aplicação, sem DDL).
APP_DB_PASSWORD=moneyflow_app
# Senha do papel moneyflow_owner (dono do banco, sem superusuário: migrations e dump/restauração).
OWNER_DB_PASSWORD=moneyflow_owner
MONEYFLOW_DB_PORT=5432
# Interface onde a porta é publicada (padrão só loopback; 0.0.0.0 expõe na rede).
MONEYFLOW_DB_BIND=127.0.0.1
