# MoneyFlow — variáveis de ambiente (copie para .env). Não use estes valores em produção.

# --- Banco (lidas também por database/docker-compose.yml via include) ---
POSTGRES_USER=moneyflow
POSTGRES_PASSWORD=moneyflow
POSTGRES_DB=moneyflow
# Senha do papel moneyflow_app (só DML), usado pela aplicação.
APP_DB_PASSWORD=moneyflow_app
# Porta publicada do Postgres no host.
MONEYFLOW_DB_PORT=5432

# --- Aplicação ---
# Conexão da aplicação: SEMPRE como moneyflow_app (nunca o dono do banco).
DATABASE_URL=postgres://moneyflow_app:moneyflow_app@localhost:5432/moneyflow
# Conexão do dono do banco: `pnpm db:pull` (introspecção) e o dump/restauração do banco em
# Administração → Backup e restauração (pg_dump/pg_restore; spec 019). Sem ela, o dump fica desligado.
DATABASE_OWNER_URL=postgres://moneyflow:moneyflow@localhost:5432/moneyflow?sslmode=disable
# Porta da API (em dev o Vite, na 5174, encaminha /api para ela).
PORT=3001
# Admin criado no primeiro boot, se não houver usuários (spec 002).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@moneyflow.local
ADMIN_PASSWORD=troque-esta-senha
# true atrás de HTTPS (cookie de sessão só por TLS).
COOKIE_SECURE=false
# Validade da sessão, em dias.
SESSION_DAYS=30
# Intervalo do worker (materialização das séries), em ms.
WORKER_INTERVAL_MS=3600000
# Worker fecha sozinho as faturas de cartão na data de fechamento (padrão false: a tela só sugere).
CARD_AUTO_CLOSE=false
# Mensagens (spec 013): URL base da Bot API do Telegram (troque por um mock nos testes/e2e),
# timeout do envio, intervalo do laço de mensagens do worker (eventos, sino e outbox) em ms,
# URL pública do console para os links nas mensagens (vazia = sem link) e o horário (São Paulo)
# dos avisos diários do sino.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000
MESSAGE_INTERVAL_MS=30000
APP_URL=
NOTIFY_AT=08:00

# --- Agentes de IA (spec 011) ---
# Provedores, chaves e agentes são cadastrados na tela Administração → IA e agentes (as chaves ficam no banco,
# write-only). Aqui só o ritmo do worker e o agente dos fluxos.
# Intervalo de busca de execuções na fila (ms) e execuções simultâneas por worker.
AGENT_POLL_MS=1000
AGENT_CONCURRENCY=4
# Manutenção: retenção de eventos (7 dias), expiração de confirmações esquecidas, embeddings (ms).
AGENT_MAINTENANCE_MS=300000
# Espera máxima da leitura de documento por IA (ms).
AI_DOCUMENT_TIMEOUT_MS=120000
# Timeout das consultas de CNPJ (CNPJ Aberto/BrasilAPI) e CEP (ViaCEP), em ms.
LOOKUP_TIMEOUT_MS=5000
# Consulta de CNPJ no CNPJ Aberto (https://cnpjaberto.com.br/api-docs, header X-API-Key; spec 003).
# true liga (exige a chave); a BrasilAPI vira o fallback se o CNPJ Aberto falhar. A chave é segredo: guarde-a
# em .local/cnpjaberto.env (fora do git; o compose da raiz e o `pnpm dev` carregam esse arquivo), não aqui.
CNPJ_ABERTO_ENABLED=false
# CNPJ_ABERTO_API_KEY=
LOG_LEVEL=info

# --- Backup e restauração (spec 019) ---
# Pasta do pg_dump/pg_restore do PostgreSQL 18 (vazio = PATH; a imagem Docker já traz o cliente).
PG_BIN_DIR=
# Tamanho máximo do arquivo enviado na importação e na restauração, em MB.
BACKUP_MAX_UPLOAD_MB=512

# --- Docker Compose da raiz (pilha completa) ---
# Porta publicada da API (que também serve o SPA).
APP_PORT=3000
# Porta publicada do Postgres da pilha (separado do banco de desenvolvimento, na 5432).
STACK_DB_PORT=5433
# Tentativas de login por minuto por IP.
LOGIN_RATE_LIMIT=10
