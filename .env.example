# MoneyFlow — variáveis de ambiente (copie para .env). Não use estes valores em produção.

# --- Banco (lidas também por database/docker-compose.yml via include) ---
POSTGRES_USER=moneyflow
POSTGRES_PASSWORD=moneyflow
POSTGRES_DB=moneyflow
# Senha do papel moneyflow_app (só DML), usado pela aplicação.
APP_DB_PASSWORD=moneyflow_app
# Senha do papel moneyflow_owner: o dono do banco SEM superusuário (sem SUPERUSER/CREATEROLE/CREATEDB), que roda as
# migrations e o dump/restauração (tarefa 054, docs/016). O superusuário (POSTGRES_USER) fica só para o cluster.
OWNER_DB_PASSWORD=moneyflow_owner
# A porta e a interface do banco de desenvolvimento (5432) ficam em database/.env (MONEYFLOW_DB_PORT, MONEYFLOW_DB_BIND):
# o `make -C database …` roda o compose dentro de database/. A pilha da raiz publica o dela em STACK_DB_PORT (abaixo).

# --- Aplicação ---
# Variáveis numéricas (portas, *_MS, *_DAYS, limites): vazia = o padrão; valor que não é inteiro ou fora da faixa
# impede o boot com a mensagem que cita a variável (tarefa 110). NOTIFY_AT fora do formato HH:MM também.
# Conexão da aplicação: SEMPRE como moneyflow_app (nunca o dono do banco).
DATABASE_URL=postgres://moneyflow_app:moneyflow_app@localhost:5432/moneyflow
# Prazos de cada conexão do pool, em ms (tarefa 102, docs/016): consulta (60 s; o backup JSON, a busca do admin em
# todas as conversas e os relatórios têm mais, na própria transação), espera por lock (30 s; também o da restauração do
# dump), transação parada (5 min) e espera por uma conexão livre (10 s). Passou do prazo: 503 com "tente de novo".
DB_STATEMENT_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
DB_CONNECTION_TIMEOUT_MS=10000
# Conexão do dono do banco: `pnpm db:pull` (introspecção) e o dump/restauração do banco em
# Administração → Backup e restauração (pg_dump/pg_restore/psql; spec 019). Sem ela, o dump fica desligado.
# Em produção, um papel dono sem SUPERUSER/CREATEROLE/CREATEDB, dono do banco, do schema public e dos objetos (rode as
# migrations com ele), com as extensões (vector, pg_trgm, citext) criadas pelo superusuário. Um superusuário aqui
# ainda funciona, mas a restauração avisa no log: quem restaura um dump forjado manda no cluster inteiro.
DATABASE_OWNER_URL=postgres://moneyflow_owner:moneyflow_owner@localhost:5432/moneyflow?sslmode=disable
# Porta da API. Em dev, o Vite lê esta mesma variável deste arquivo e encaminha /api e /mcp para ela.
PORT=3001
# Interface em que a API escuta (sem a variável, 0.0.0.0: todas, como na imagem). 127.0.0.1 deixa o `pnpm dev` só no
# host; 0.0.0.0 expõe a API de desenvolvimento, com o admin de senha conhecida, na rede.
HOST=127.0.0.1
# Só no `pnpm dev`: a porta do Vite (padrão 5174) e, se a API estiver noutra porta que não a PORT, a do proxy.
# WEB_PORT=5174
# API_PORT=3001
# Modo do processo quando o comando não diz (api ou worker; padrão api). O `pnpm dev`/`dev:worker`, o compose e a
# imagem já passam o modo.
# MODE=api
# Pasta do console compilado (apps/web/dist) que a API serve com o SPA. A imagem define /app/web; sem ela, a API
# responde só em /api e /mcp, como no `pnpm dev`, em que o Vite serve o console.
# WEB_DIST=apps/web/dist
# Admin criado no primeiro boot, se não houver usuários (spec 002).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@moneyflow.local
ADMIN_PASSWORD=troque-esta-senha
# true atrás de HTTPS (cookie de sessão só por TLS). Com false e APP_URL/PUBLIC_BASE_URL em https, a API avisa no boot.
COOKIE_SECURE=false
# Validade da sessão, em dias.
SESSION_DAYS=30
# Ociosidade máxima da sessão, em horas: sem uso nesse tempo, é preciso entrar de novo (0 desliga; docs/002).
SESSION_IDLE_HOURS=72
# Tentativas de login por minuto por IP.
LOGIN_RATE_LIMIT=10
# Proxies reversos que podem informar o IP do cliente pelo X-Forwarded-For (IPs, CIDRs ou
# loopback/linklocal/uniquelocal, separados por vírgula). Vazio = nenhum: o IP é o da conexão.
# Atrás de um proxy (produção), liste-o aqui; sem isso todos aparecem com o IP dele (docs/002, docs/018).
TRUSTED_PROXIES=
# Intervalo do worker (materialização das séries), em ms.
WORKER_INTERVAL_MS=3600000
# Worker fecha sozinho as faturas de cartão na data de fechamento (padrão false: a tela só sugere).
CARD_AUTO_CLOSE=false
# Parada (SIGTERM/SIGINT; tarefa 107, docs/018): prazo em ms para devolver à fila as execuções de agente e terminar
# as passadas em andamento (padrão 8000, abaixo dos 10 s do docker stop). O worker grava a cada passada do laço de
# mensagens o arquivo do healthcheck da imagem (padrão <tmp>/moneyflow-worker-heartbeat; WORKER_HEARTBEAT_FILE troca).
SHUTDOWN_GRACE_MS=8000
# WORKER_HEARTBEAT_FILE=/tmp/moneyflow-worker-heartbeat
# Mensagens (spec 013): URL base da Bot API do Telegram (troque por um mock nos testes/e2e),
# timeout do envio, intervalo do laço de mensagens do worker (eventos, sino e outbox) em ms,
# URL pública do console para os links nas mensagens (vazia = sem link) e o horário (São Paulo)
# dos avisos diários do sino.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000
MESSAGE_INTERVAL_MS=30000
APP_URL=
NOTIFY_AT=08:00
# Telegram de entrada (spec 029): URL pública HTTPS desta API, base do webhook (<URL>/api/telegram/webhook/<destino>).
# Sem ela (ou sem HTTPS), "Receber mensagens" fica desligado. O valor salvo em Administração → IA (app_settings
# telegram.public_base_url) vence este.
PUBLIC_BASE_URL=

# --- Agentes de IA (spec 011) ---
# Provedores, chaves e agentes são cadastrados na tela Administração → IA e agentes (as chaves ficam no banco,
# write-only). Aqui só o ritmo do worker e o agente dos fluxos.
# Intervalo de busca de execuções na fila (ms) e execuções simultâneas por worker.
AGENT_POLL_MS=1000
AGENT_CONCURRENCY=4
# Manutenção: retenção de eventos (7 dias), expiração de confirmações esquecidas, embeddings (ms).
AGENT_MAINTENANCE_MS=300000
# Laço das tarefas agendadas dos agentes (spec 029): a cada quanto o worker dispara as vencidas (ms).
AGENT_TASK_INTERVAL_MS=30000
# Espera máxima da leitura de documento por IA (ms); esgotada, a execução é cancelada.
AI_DOCUMENT_TIMEOUT_MS=120000
# Espera máxima da conversão do PDF do contrato em markdown (ms; padrão 5 min, a saída é o documento inteiro).
# AI_DOCUMENT_CONVERT_TIMEOUT_MS=300000
# Teto do tamanho estimado de uma chamada ao modelo, em bytes (padrão 30 MiB, abaixo dos 32 MB da Anthropic):
# acima dele a execução falha sem chamar o provedor e pede para finalizar a sessão.
# AI_REQUEST_MAX_BYTES=31457280
# Requisições ao provedor (spec 023). Tentativas do próprio MoneyFlow por chamada (o retry dos SDKs fica desligado):
# repete 408, 409, 429, 5xx/529, erro de rede e timeout, com espera de 1 s, 2 s, 4 s… (com jitter) ou o retry-after
# informado (até 60 s); um stream que caiu depois de começar não se repete (a execução volta à fila).
AI_REQUEST_MAX_ATTEMPTS=3
# Retenção padrão das requisições registradas, em dias (1–365). O valor salvo na tela (IA e agentes → Requisições)
# fica no banco e vence este; "Usar o padrão" volta a valer a variável. O worker purga na manutenção.
AI_REQUEST_RETENTION_DAYS=30
# Base do backoff entre as tentativas, em ms (padrão 1000; os testes usam menos).
# AI_REQUEST_BACKOFF_MS=1000
# Chat multimídia (spec 025): espera máxima da execução pelas transcrições pendentes dos áudios da mensagem (ms);
# esgotada, o modelo recebe o áudio como "sem transcrição".
AI_TRANSCRIPTION_TIMEOUT_MS=120000
# Limite de execuções de IA por minuto, por usuário (spec 028): sessões do chat e fluxos automáticos contam à parte
# (inteiro 1–1000; vale também para o admin). O valor salvo na tela (IA e agentes → Uso) fica no banco e vence estes.
AI_RUNS_PER_MINUTE=10
AI_FLOW_RUNS_PER_MINUTE=30
# Timeout das consultas de CNPJ (CNPJ Aberto/BrasilAPI) e CEP (ViaCEP), em ms.
LOOKUP_TIMEOUT_MS=5000
# Consulta de CNPJ no CNPJ Aberto (https://cnpjaberto.com.br/api-docs, header X-API-Key; spec 003).
# true liga (exige a chave); a BrasilAPI vira o fallback se o CNPJ Aberto falhar. A chave é segredo: guarde-a
# em .local/cnpjaberto.env (fora do git; o compose da raiz e o `pnpm dev` carregam esse arquivo), não aqui.
CNPJ_ABERTO_ENABLED=false
# CNPJ_ABERTO_API_KEY=
# URLs base das consultas (troque por um mock nos testes; vazias = as públicas).
# CNPJ_ABERTO_BASE=https://cnpjaberto.com.br
# BRASILAPI_BASE=https://brasilapi.com.br
LOG_LEVEL=info

# --- Backup e restauração (spec 019) ---
# Pasta do pg_dump/pg_restore do PostgreSQL 18 (vazio = PATH; a imagem Docker já traz o cliente).
PG_BIN_DIR=
# Tamanho máximo do arquivo enviado na importação e na restauração, em MB.
BACKUP_MAX_UPLOAD_MB=512

# --- Docker Compose da raiz (pilha completa) ---
# Porta publicada da API (que também serve o SPA).
APP_PORT=3000
# Porta publicada do Postgres da pilha (separado do banco de desenvolvimento, na 5432).
STACK_DB_PORT=5433
# Interface em que essa porta é publicada (padrão 127.0.0.1, só o host). 0.0.0.0 expõe o banco na rede,
# com o superusuário: só de propósito. O banco de desenvolvimento tem o MONEYFLOW_DB_BIND (database/.env.example).
STACK_DB_BIND=127.0.0.1
