# MoneyFlow — variáveis de ambiente (copie para .env). Não use estes valores em produção.

# --- Banco (lidas também por database/docker-compose.yml via include) ---
POSTGRES_USER=moneyflow
POSTGRES_PASSWORD=moneyflow
POSTGRES_DB=moneyflow
# Senha do papel moneyflow_app (só DML), usado pela aplicação.
APP_DB_PASSWORD=moneyflow_app
# Porta publicada do Postgres no host.
MONEYFLOW_DB_PORT=5432

# --- Aplicação ---
# Conexão da aplicação: SEMPRE como moneyflow_app (nunca o dono do banco).
DATABASE_URL=postgres://moneyflow_app:moneyflow_app@localhost:5432/moneyflow
# Só para `pnpm db:pull` (introspecção com o dono do banco).
DATABASE_OWNER_URL=postgres://moneyflow:moneyflow@localhost:5432/moneyflow?sslmode=disable
# Porta da API (em dev o Vite, na 5174, encaminha /api para ela).
PORT=3001
# Admin criado no primeiro boot, se não houver usuários (spec 002).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@moneyflow.local
ADMIN_PASSWORD=troque-esta-senha
# true atrás de HTTPS (cookie de sessão só por TLS).
COOKIE_SECURE=false
# Validade da sessão, em dias.
SESSION_DAYS=30
# Intervalo do worker (materialização das séries), em ms.
WORKER_INTERVAL_MS=3600000
# Worker fecha sozinho as faturas de cartão na data de fechamento (padrão false: a tela só sugere).
CARD_AUTO_CLOSE=false
# Timeout das consultas de CNPJ (BrasilAPI) e CEP (ViaCEP), em ms.
LOOKUP_TIMEOUT_MS=5000
LOG_LEVEL=info

# --- Docker Compose da raiz (pilha completa) ---
# Porta publicada da API (que também serve o SPA).
APP_PORT=3000
# Porta publicada do Postgres da pilha (separado do banco de desenvolvimento, na 5432).
STACK_DB_PORT=5433
# Tentativas de login por minuto por IP.
LOGIN_RATE_LIMIT=10
