{
  "name": "@moneyflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts api",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main.ts worker",
    "build": "node build.mjs",
    "start": "node dist/main.mjs api",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@moneyflow/db": "workspace:*",
    "@moneyflow/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "zod": "4.6.5",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
